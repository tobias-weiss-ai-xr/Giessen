graph TD
    subgraph Cluster["Kubernetes Cluster"]
        direction TB

        subgraph Control["Control Plane"]
            API["API Server"]
            Sched["Scheduler"]
            CM["Controller Manager"]
            Etcd[("etcd")]
        end

        subgraph Workers["Worker Nodes"]
            N1["Node 1"]
            N2["Node 2"]
            N3["Node 3"]
        end

        API --> Sched
        API --> CM
        CM --> Etcd
        Sched --> N1
        Sched --> N2
        Sched --> N3
    end

    subgraph Pods["OpenDesk Edu Pods"]
        PF["Frontend\nNext.js"]
        PB["Backend\nNode.js"]
        PA["Agenten\n4 Services"]
        PAI["AI\nOllama"]
        PS["Storage\nPostgreSQL"]
    end

    N1 --> PF
    N1 --> PB
    N2 --> PA
    N2 --> PAI
    N3 --> PS

    style Control fill:#f0f8ff,stroke:#bdc3c7
    style Workers fill:#f0f8ff,stroke:#bdc3c7
    style Pods fill:#e8f4fd,stroke:#3498db
    style Cluster fill:#fafafa,stroke:#bdc3c7
